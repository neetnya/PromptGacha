<Window x:Class="PromptGacha.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PromptGacha · 提示词抽卡器" Height="760" Width="1180"
        MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Window.Resources>
        <!-- 参数行统一高度，避免下拉框被行高压扁 -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左：参数 + 日志 ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="通用" Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="等级" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbLevel" SelectedIndex="1">
                            <ComboBoxItem Content="sfw" />
                            <ComboBoxItem Content="suggestive" />
                            <ComboBoxItem Content="explicit" />
                            <ComboBoxItem Content="hardcore" />
                            <ComboBoxItem Content="extreme" />
                            <ComboBoxItem Content="any" />
                        </ComboBox>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="连抽" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtRepeat" Text="1" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="girl —— 女性特征" Padding="6" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="池" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CmbPool"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="热门 TOP200" />
                                <ComboBoxItem Content="热门 TOP1000" />
                                <ComboBoxItem Content="全部女性" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="关系" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbRelation" SelectedIndex="0">
                                <ComboBoxItem Content="auto（按等级）" Tag="auto" />
                                <ComboBoxItem Content="normal（正常互动）" Tag="normal" />
                                <ComboBoxItem Content="yuri（百合）" Tag="yuri" />
                                <ComboBoxItem Content="none（不加）" Tag="none" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="人数" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="CmbCount" SelectedIndex="0">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                            </ComboBox>
                        </Grid>

                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox x:Name="ChkHuge" Content="强制巨乳" Margin="0,0,14,4" />
                            <CheckBox x:Name="ChkNoAvoid" Content="关闭避重" Margin="0,0,14,4" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="roll —— 服装 / 姿势 / 表情 / 场景" Padding="6" Margin="0,8,0,0">
                    <WrapPanel>
                        <CheckBox x:Name="ChkNoOutfit" Content="不抽服装" Margin="0,0,14,4" />
                        <CheckBox x:Name="ChkNoPose" Content="不抽姿势" Margin="0,0,14,4" />
                        <CheckBox x:Name="ChkNoExpr" Content="不抽表情" Margin="0,0,14,4" />
                        <CheckBox x:Name="ChkNoScene" Content="不抽场景" Margin="0,0,14,4" />
                        <CheckBox x:Name="ChkAllowPublic" Content="允许公共场合暴露" Margin="0,0,14,4" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Grid.Row="3" Header="日志" Padding="6" Margin="0,8,0,0">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True"
                             Height="Auto" VerticalAlignment="Stretch" Margin="0"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             FontFamily="Consolas, Microsoft YaHei" FontSize="12" />
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="#DDD" ResizeBehavior="PreviousAndNext" />

            <!-- ============ 右：提示词 ============ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="2,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="提示词" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" x:Name="TxtMeta" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="#666" FontSize="12" />
                    <Button DockPanel.Dock="Right" x:Name="BtnCopy" Content="复制" Padding="12,2" Height="24" Click="OnCopy" />
                    <Button DockPanel.Dock="Right" x:Name="BtnSave" Content="保存…" Padding="12,2" Height="24"
                            Margin="0,0,6,0" Click="OnSave" />
                </DockPanel>

                <TextBox Grid.Row="1" x:Name="TxtResult" IsReadOnly="True" AcceptsReturn="True"
                         Height="Auto" VerticalAlignment="Stretch" Margin="0"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         FontFamily="Consolas, Microsoft YaHei" FontSize="13"
                         Background="#FCFCFC" />
            </Grid>
        </Grid>

        <!-- ============ 底栏 ============ -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnGirl" Content="抽 girl" Padding="18,6"
                    FontWeight="SemiBold" Click="OnGirl" ToolTip="只抽女性特征" />
            <Button Grid.Column="1" x:Name="BtnGirlRoll" Content="抽 girl + roll" Padding="18,6"
                    FontWeight="SemiBold" Margin="8,0,0,0" Click="OnGirlRoll"
                    ToolTip="先抽特征，再在这套特征上抽服装 / 姿势 / 表情 / 场景" />
            <Button Grid.Column="2" x:Name="BtnRoll" Content="抽 roll" Padding="18,6"
                    FontWeight="SemiBold" Margin="8,0,0,0" Click="OnRoll" ToolTip="在当前提示词为空时从头抽一套搭配" />
            <Button Grid.Column="3" x:Name="BtnCancel" Content="取消" Padding="14,6"
                    Margin="8,0,0,0" IsEnabled="False" Click="OnCancel" />
            <TextBlock Grid.Column="4" x:Name="TxtStatus" VerticalAlignment="Center"
                       Margin="12,0,0,0" Foreground="#444" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
