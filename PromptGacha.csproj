<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PromptGacha</AssemblyName>
    <RootNamespace>PromptGacha</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SilentResourceLanguages>en</SilentResourceLanguages>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Product>PromptGacha</Product>
    <AssemblyTitle>PromptGacha 提示词抽卡器</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Python 引擎：随生成一起拷到输出目录的 engine\ 下，exe 同级即可找到 -->
    <None Remove="engine\**\__pycache__\**" />
    <None Update="engine\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
